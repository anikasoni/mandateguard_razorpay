MANDATEGUARD_ENV=development
MANDATEGUARD_DATABASE_URL=sqlite+pysqlite:///./var/mandateguard.db
MANDATEGUARD_PENDING_APPROVAL_TTL_SECONDS=900
MANDATEGUARD_CHECKOUT_RESERVATION_TTL_SECONDS=300
# Set to a private value of at least 16 characters for the local human approval endpoint.
# MANDATEGUARD_HUMAN_APPROVAL_KEY=<private-local-demo-value>
MANDATEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
