MANDATEGUARD_ENVIRONMENT=development
MANDATEGUARD_LOG_LEVEL=INFO
MANDATEGUARD_DATABASE_URL=sqlite+pysqlite:///./var/mandateguard.db
MANDATEGUARD_PENDING_APPROVAL_TTL_SECONDS=900
MANDATEGUARD_CHECKOUT_RESERVATION_TTL_SECONDS=300
# Set to a private value of at least 16 characters for the local human approval endpoint.
# MANDATEGUARD_HUMAN_APPROVAL_KEY=<private-local-demo-value>
# Optional: enables the bounded Gemini purchasing planner. Never commit a real key.
# MANDATEGUARD_GEMINI_API_KEY=<private-gemini-api-key>
MANDATEGUARD_GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: enables real Razorpay test-mode Orders. Use test keys only.
# MANDATEGUARD_RAZORPAY_KEY_ID=<rzp_test_key_id>
# MANDATEGUARD_RAZORPAY_KEY_SECRET=<private-test-key-secret>
MANDATEGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
