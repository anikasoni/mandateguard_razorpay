root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = lf
indent_style = space
indent_size = 4

[{*.py,*.toml,*.yml,*.yaml}]
indent_style = space
indent_size = 4

[{*.js,*.json,*.ts,*.tsx,*.css,*.html}]
indent_style = space
indent_size = 2
